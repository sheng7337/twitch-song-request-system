# ========================================================
#  VTuber Song Queue -- Configuration
#  Copy this file to .env and fill in your values.
#  The setup wizard at http://localhost:3000/setup
#  will fill most of these in automatically.
# ========================================================


# --- Twitch App ---
# From https://dev.twitch.tv/console/apps -> your app -> Manage
# Only the Client ID is needed (no Client Secret required)

TWITCH_CLIENT_ID=your_client_id_here


# --- Twitch Channel ---
# Filled in automatically by the setup wizard

TWITCH_BROADCASTER_ID=


# --- Twitch Tokens ---
# Filled in automatically by the setup wizard (Device Authorization Flow)
# Do not edit these manually

TWITCH_USER_ACCESS_TOKEN=
TWITCH_USER_REFRESH_TOKEN=
TWITCH_USER_TOKEN_EXPIRES_AT=


# --- Twitch Channel Points Rewards ---
# Filled in automatically by the setup wizard

TWITCH_REWARD_ID=

# Random song rewards: JSON array, each entry can restrict to specific sheet tabs.
# tabs:[] means all tabs. Set automatically by the setup wizard.
# Example: [{"id":"abc","name":"隨機日語點歌","tabs":["日語"]},{"id":"def","name":"隨機點歌","tabs":[]}]
TWITCH_RANDOM_REWARDS=


# --- Google Sheets ---
# Sheet ID is the long string in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit

GOOGLE_SHEET_ID=
SHEET_SONG_COLUMN=title
SHEET_ARTIST_COLUMN=artist
# Optional transpose column (numbers like 0, -2, 3)
SHEET_KEY_COLUMN=key

# Optional: separate sheet for request history tracking
HISTORY_SHEET_ID=

# Optional: tabs left out of requests, random picks and the link finder
# (e.g. a practice tab), comma-separated. Unset = the default practice tab
# (see SETUP_MANUAL.md); empty = every tab is used.
# EXCLUDED_TABS=


# --- Sponsor Roll (!tk command) ---
# Drop background images into clip-player/sponsor-bgs/ (jpg/png/gif/webp).
# One is chosen at random each time !tk is called.
# If the folder has no images, a dark background is shown.


# --- Server ---
PORT=3000


# --- Random Song Behaviour ---
# pure     = truly random pick from all eligible songs
# weighted = favor songs that haven't been played recently (recommended)
RANDOM_PICK_MODE=weighted

# Days that must pass after a song is requested before the Random Song
# reward can pick it again. 0 = no cooldown (max 60). Adjustable from the dashboard.
RANDOM_COOLDOWN_DAYS=7

# Overlay panel background opacity, from 0 (fully transparent) to 1 (solid).
# Adjustable from the dashboard.
OVERLAY_PANEL_BG_ALPHA=0.92

# Overlay brightness, from 0.5 (darker) to 2 (brighter). 1 = normal.
# Adjustable from the dashboard.
OVERLAY_TEXT_BRIGHTNESS=1

# Language viewers see on the overlay and clip player: en or zh-TW.
# Adjustable from the dashboard.
OVERLAY_LANGUAGE=en


# --- Leihu Singsing (optional backing tracks + lyrics) ---
# Address of Leihu Singsing on this PC. Only change it if Leihu uses another port.
LEIHU_URL=http://127.0.0.1:8765
# Python used by the dashboard's YouTube link finder. Leave unset: it is found
# automatically in Leihu's install folder (python\python.exe for the packaged app,
# .venv\Scripts\python.exe or venv\Scripts\python.exe for a source install).
# When set, only this Python is used.
# LEIHU_PYTHON=E:\path\to\python.exe
# 1 = import queued songs (from the sheet's YTLink column, which the dashboard's
# link finder creates and fills) and render their key
# ahead of time. Uses the GPU during stream. Adjustable from the dashboard.
LEIHU_AUTO_PREPARE=0
