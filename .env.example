# ========================================================
#  VTuber Song Queue -- Configuration
#  Copy this file to .env and fill in your values.
#  The setup wizard at http://localhost:3000/setup
#  will fill most of these in automatically.
# ========================================================


# --- Twitch App ---
# From https://dev.twitch.tv/console/apps -> your app -> Manage
# Only the Client ID is needed (no Client Secret required)

TWITCH_CLIENT_ID=your_client_id_here


# --- Twitch Channel ---
# Filled in automatically by the setup wizard

TWITCH_BROADCASTER_ID=


# --- Twitch Tokens ---
# Filled in automatically by the setup wizard (Device Authorization Flow)
# Do not edit these manually

TWITCH_USER_ACCESS_TOKEN=
TWITCH_USER_REFRESH_TOKEN=
TWITCH_USER_TOKEN_EXPIRES_AT=


# --- Twitch Channel Points Rewards ---
# Filled in automatically by the setup wizard

TWITCH_REWARD_ID=
TWITCH_RANDOM_REWARD_ID=


# --- Google Sheets ---
# Sheet ID is the long string in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit

GOOGLE_SHEET_ID=
SHEET_SONG_COLUMN=title
SHEET_ARTIST_COLUMN=artist

# Optional: separate sheet for request history tracking
HISTORY_SHEET_ID=


# --- Server ---
PORT=3000


# --- Random Song Behaviour ---
# pure     = truly random pick from all eligible songs
# weighted = favor songs that haven't been played recently (recommended)
RANDOM_PICK_MODE=weighted

# Days that must pass after a song is requested before the Random Song
# reward can pick it again. 0 = no cooldown (max 60). Adjustable from the dashboard.
RANDOM_COOLDOWN_DAYS=7

# Overlay panel background opacity, from 0 (fully transparent) to 1 (solid).
# Adjustable from the dashboard.
OVERLAY_PANEL_BG_ALPHA=0.92
